{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node -e \"fetch(process.env.APP_URL + '/api/cron/group-feed',{method:'POST',headers:{authorization:'Bearer ' + process.env.CRON_SECRET}}).then(async r=>{console.log(r.status,await r.text());process.exit(r.ok?0:1)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "restartPolicyType": "NEVER"
  }
}
